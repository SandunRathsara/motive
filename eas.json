{
  "cli": {
    "version": ">= 19.1.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "autoIncrement": false,
      "env": { "APP_VARIANT": "owner", "EXPO_PUBLIC_APP_VARIANT": "owner" }
    },
    "owner": {
      "developmentClient": false,
      "distribution": "internal",
      "autoIncrement": false,
      "env": { "APP_VARIANT": "owner", "EXPO_PUBLIC_APP_VARIANT": "owner" }
    },
    "verification": {
      "developmentClient": false,
      "distribution": "internal",
      "autoIncrement": false,
      "env": { "APP_VARIANT": "verification", "EXPO_PUBLIC_APP_VARIANT": "verification" }
    }
  }
}
